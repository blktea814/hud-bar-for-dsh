{
  "name": "hud-floating-bar",
  "version": "0.1.0",
  "description": "DSH plugin: floating HUD chat bar with live transcript, workspace/session/model/reasoning-effort switching, and Picture-in-Picture detach mode. Official bundle plugin.",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client/index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "ui",
    "hud",
    "overlay",
    "pip"
  ],
  "license": "MIT"
}
